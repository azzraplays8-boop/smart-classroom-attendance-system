# ─────────────────────────────────────────────────────────────────────
#  KATAGA Portal — Frontend Environment Variables
#  Copy this file to `.env.local` for local development (already
#  gitignored via `*.local`). For production, set the SAME variable in
#  your Vercel dashboard under Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────

# REQUIRED — Backend API base URL (the deployed backend, no trailing slash).
#
# Production (Vercel / Render): the FULL deployed HTTPS backend URL, e.g.
#   VITE_API_BASE_URL=https://kataga-backend.onrender.com
#   VITE_API_BASE_URL=https://your-api.example.com
#
# Local development (backend runs on port 5000 per backend/.env):
#   VITE_API_BASE_URL=http://localhost:5000
#
# ⚠️ The frontend is deployed separately from the backend. In PRODUCTION
# this must be the actual deployed backend URL — never a localhost address.
# This app has NO localhost fallback and REQUIRES this variable at runtime.
VITE_API_BASE_URL=
