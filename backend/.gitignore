# ── Environment & secrets ─────────────────────────────
# Never commit real environment variables.
.env
.env.*
!.env.example

# ── Dependencies ───────────────────────────────────────
node_modules/

# ── Logs ───────────────────────────────────────────────
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Runtime data ───────────────────────────────────────
# Uploaded files are not tracked in version control.
uploads/

# ── Editor / OS files ──────────────────────────────────
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
