# ═══════════════════════════════════════════════════════════════════
#  Smart Attendance System — Backend Environment Variables
#  Production-ready template
#
#  Copy this file to `.env` for local development, and set the same
#  variables in your Render dashboard (Environment tab) for production.
#  NEVER commit the real `.env` file.
# ═══════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────────────
# Port the Express server listens on.
# Render injects its own PORT automatically — do NOT hardcode it there.
# For local development, 5000 matches the Vite fallback.
PORT=5000

# ─────────────────────────────────────────────────────────────────────
# CORS — allowed frontend origins
# ─────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call this API.
# In production, set this to your Vercel frontend URL(s).
# Example:
#   CORS_ORIGIN=https://your-app.vercel.app
#   CORS_ORIGIN=https://your-app.vercel.app,https://staging.vercel.app
#
# If left empty, ALL origins are allowed (development only — NOT for production).
CORS_ORIGIN=

# ─────────────────────────────────────────────────────────────────────
# Authentication — JWT
# ─────────────────────────────────────────────────────────────────────
# REQUIRED. The secret used to sign JWTs. Generate a strong random value,
# for example:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server FAILS to start if this is missing.
JWT_SECRET=

# ─────────────────────────────────────────────────────────────────────
# Database — MySQL (online provider: Railway / Aiven / TiDB Cloud)
# ─────────────────────────────────────────────────────────────────────
# EITHER provide the individual DB_* variables below...
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# ...OR provide a single connection URL (takes precedence over DB_*).
# Example:
#   mysql://user:password@host:port/dbname
#   mysql://user:password@host:port/dbname?ssl-mode=REQUIRED
DATABASE_URL=

# Enable SSL/TLS for the DB connection. Managed MySQL providers require this.
#   true / 1 / required  → enable TLS
#   false / 0 / none     → disable TLS (local development)
DB_SSL=false

# Optional: path to a PEM CA bundle from your provider (e.g. Aiven/Railway).
# If set, the server certificate is verified against this CA.
# Leave empty to use relaxed TLS verification.
DB_SSL_CA_PATH=

# Connection pool size. Defaults to 10.
DB_CONNECTION_LIMIT=10

# ─────────────────────────────────────────────────────────────────────
# Schema / Migrations
# ─────────────────────────────────────────────────────────────────────
# Run the schema + migrations automatically on startup (default true).
# The SQL is idempotent (CREATE TABLE IF NOT EXISTS), so it is safe to
# leave enabled. Set to "false" to disable auto-migration (e.g. when you
# provision the schema manually or via a separate migration step).
DB_AUTO_MIGRATE=true

# Optional: override the path to the root schema.sql file.
# Defaults to ./sql/schema.sql. Usually leave empty.
DB_ROOT_SQL_PATH=

# ─────────────────────────────────────────────────────────────────────
# Notes for Render
# ─────────────────────────────────────────────────────────────────────
# 1. Render sets PORT automatically. The app binds to 0.0.0.0.
# 2. Start command:  npm start
# 3. Build command:  npm install
# 4. Set DATABASE_URL (or DB_*) and JWT_SECRET, and CORS_ORIGIN in the
#    Render "Environment" tab.
# 5. Uploaded participant photos are stored on the local filesystem, which
#    is ephemeral on Render. For persistent uploads, integrate a cloud
#    storage service (e.g. S3 / Cloudinary) in a future release.
